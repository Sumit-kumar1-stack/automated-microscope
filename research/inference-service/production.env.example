# ============================================================
# Automated Microscope Research Inference Service
# Production-style runtime configuration
# ============================================================
#
# These settings control service/runtime behavior only.
#
# They MUST NOT be used to change frozen model thresholds,
# architecture, classifier classes or validation settings.
# ============================================================


# Runtime environment:
# development | test | production
INFERENCE_ENV=production


# Uvicorn bind configuration.
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000


# critical | error | warning | info | debug
INFERENCE_LOG_LEVEL=info


# Maximum simultaneous requests accepted by Uvicorn.
#
# Model execution itself remains serialized by MODEL_LOCK
# because the CPU research service owns one copy of the
# frozen detector and classifier.
INFERENCE_LIMIT_CONCURRENCY=8


# Maximum accepted microscopy image upload size.
#
# Allowed configuration range: 1-100 MB.
INFERENCE_MAX_UPLOAD_MB=20


# Comma-separated frontend origins.
#
# Never use "*" for the production research service.
INFERENCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000