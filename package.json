{
  "name": "automated-microscope",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:scan:stage": "tsx src/lib/scan/simulated-xy-stage.test.ts",
    "test:scan:runner": "tsx src/lib/scan/scan-runner.test.ts",
    "test:scan:autofocus": "tsx src/lib/scan/scan-autofocus.test.ts",
    "test:scan:acquisition": "tsx src/lib/scan/scan-acquisition.test.ts",
    "test:scan:aggregation": "tsx src/lib/scan/scan-slide-summary.test.ts",
    "test:scan:robustness": "tsx src/lib/scan/scan-runner-robustness.test.ts",
    "test:scan:hardware": "tsx src/lib/scan/hardware-xy-stage.test.ts",
    "test:ml:scan": "tsx src/lib/scan/scan-ml-analyzer.test.ts",
    "test:scan": "npm run test:scan:stage && npm run test:scan:runner && npm run test:scan:autofocus && npm run test:scan:acquisition && npm run test:scan:aggregation && npm run test:scan:robustness && npm run test:scan:hardware",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:scan"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.12",
    "tsx": "^4.23.11",
    "typescript": "6.0.3"
  }
}
